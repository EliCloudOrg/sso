# 复制为 .env 后按当前阶段修改（.env 不要提交到 Git）
#
# IP 阶段（现在）：
PUBLIC_BASE_URL=https://146.56.237.33/auth
CORS_ORIGINS=http://146.56.237.33,http://localhost:3000,http://127.0.0.1:3000
#
# 域名阶段（api.elipese.cloud 可用后，只改上面两行 + 重启 + 清空 refresh_tokens）：
# PUBLIC_BASE_URL=https://api.elipese.cloud/auth
# CORS_ORIGINS=https://elipese.cloud,https://www.elipese.cloud

# 是否开放自助注册；关闭时用 `docker compose exec sso python -m app.cli create-user` 建号
ALLOW_REGISTRATION=false

# 签名密钥标识；轮换密钥时改这里（见 app/cli.py rotate-key）
JWT_KID=2026-01

# 客户端管理接口 /v1/clients 的 Bearer 令牌（留空 = 该组接口整体关闭）。
# 生成：openssl rand -hex 32
# 只给运维用；日常建客户端建议直接用容器内 CLI（不需要这个令牌）。
ADMIN_TOKEN=

# ---- OIDC 可调项（不写则用代码里的默认值，见 docs/sso-oidc.md §9）----
# AUTHORIZATION_CODE_TTL=60
# ID_TOKEN_TTL=600
# SESSION_TTL=43200
# SESSION_COOKIE_NAME=elicloud_sso_session
# DEVICE_CODE_TTL=600
# DEVICE_POLL_INTERVAL=5
